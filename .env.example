# ============================================================
# Galaxy English School - environment variables
# Copy this file to `.env` (it is git-ignored) and fill in values.
# Local development can run with just DEBUG=True below.
# ============================================================

# Django secret key. REQUIRED in production (DEBUG=False).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to False on the server; True for local development.
DEBUG=False

# Comma-separated list of allowed hosts (add your PythonAnywhere domain).
ALLOWED_HOSTS=localhost,127.0.0.1,galaxyenglishschool.pythonanywhere.com

# Database: leave as True to use SQLite. Set False + DATABASE_URL when using
# a real database such as MySQL/PostgreSQL on the server.
USE_SQLITE=True
# DATABASE_URL=mysql://user:pass@host:port/galaxy_school

# EMAIL (contact form). Default writes to console. On the server use a real
# SMTP provider (e.g. Mailgun/SendGrid). Example (Mailgun/other SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=postmaster@mg.yourdomain.com
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Galaxy English School <info@galaxyenglishschool.edu.np>
CONTACT_TO_EMAIL=info@galaxyenglishschool.edu.np
